{
  "_info": "Configurazione modificabile senza toccare il codice. Dopo la build si trova in dist/content/config.json.",

  "language": {
    "default": "it",
    "available": ["it", "en"]
  },

  "kiosk": {
    "idleResetSeconds": 60,
    "attractAfterSeconds": 25,
    "hintSeconds": 7,
    "controller": true
  },

  "audio": {
    "volume": 0.8,
    "startMuted": false
  },

  "quality": {
    "_info": "auto (parte da medium e sale fino a ultra se la scheda video regge i 60 fps) | low | medium (occlusione, riflessi a mezza risoluzione) | high (riflessi in ray tracing pieni, profondità di campo) | ultra (tutto a piena risoluzione, risoluzione 1,5x, ombre 4096). Con una scheda video dedicata si può fissare ultra.",
    "level": "auto"
  },

  "intro": {
    "_info": "Schermata iniziale. video: percorso del film in loop (senza audio), mostrato nitido a tutto schermo dietro al menu; videoBrightness: luminosità 0–1 (1 = il film così com'è, 0.9 = appena attenuato). Se il video manca o non parte, compare l'orologio che respira.",
    "video": "assets/video/celeste-intro.mp4",
    "videoBrightness": 0.9
  },

  "cta": {
    "_todo": "PLACEHOLDER: sostituire testo e URL del QR prima della fiera. Non inserire prezzi o date senza conferma.",
